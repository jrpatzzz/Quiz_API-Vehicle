<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Express Quiz App' %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="homepage-bg">

    <header class="site-header">
        <div class="logo-container">
            <img src="/pics/123.avif" alt="Logo" class="shop-logo">
        </div>

        <nav class="navbar">
            <a href="/">Home</a>
            <a href="/vehicletype">Vehicle Type</a> 
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </nav>
    </header>
    
    <div class="container">
      <h1>Vehicle Quiz Express Site</h1>
      <p style="text-align: center; color: #0344f8">
        Test your knowledge in Vehicle's with the questions from the Open Trivia Database! <br>
        Select a number of Question, and choose a level of Difficulty of yours. <br>
        <strong>Enjoy! and Goodluck..</strong>
      </p>

      <div class="quiz-controls" id="setup-area">
        <div class="form-group">
          <label for="amount">Number of Questions:</label>
          <input type="number" id="amount" min="1" max="50" value="5" />
        </div>
        <div class="form-group">
          <label for="difficulty">Difficulty:</label>
          <select id="difficulty">
            <option value="">Any Difficulty</option>
            <option value="easy">Easy</option>
            <option value="medium">Medium</option>
            <option value="hard">Hard</option>
          </select>
        </div>
        <br />
        <button id="start-quiz-btn">Start Quiz</button>
        <button id="reset-quiz-btn" style="background: #6c757d">Reset</button>
      </div>

      <div id="quiz-container"></div>
    </div>

    <script src="/js/quiz.js"></script>

    <footer class="site-footer">
        <p>&copy; 2026 CJH-VEHICLE QUIZ</p>
    </footer>

  </body>
</html>
