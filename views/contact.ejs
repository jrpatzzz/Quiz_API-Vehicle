            <a href="/">Home</a>
            <a href="/vehicletype">Vehicle Type</a> 
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </nav>
    </header>

    <div class="container">
      <main class="container">
          <section class="contact-header">
              <h1>Contact Us</h1>
              <p>Do you have questions about our vehicle trivia and Quiz? Here are the ways you can reach us.</p>
          </section>

          <section class="contact-info">
              <h2>Contact Info</h2>
              <h3>John Rommel T. Patriarca</h3>
              <p><strong>Email:</strong> jrpatriarca17@gmial.com, <strong>Phone:</strong> +63 909 697 9067, <strong>Address:</strong> Manila, Philippines</p>
              <h3>Cyril Nero S. Maligaya</h3>
              <p><strong>Email:</strong> cyrilneros@gmail.com, <strong>Phone:</strong> +63 967 473 6972, <strong>Address:</strong> Manila, Philippines</p>
