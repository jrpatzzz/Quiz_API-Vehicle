<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="homepage-bg">

    <header class="site-header">
        <div class="logo-container">
            <img src="/pics/123.avif" alt="Logo" class="shop-logo">
        </div>

        <nav class="navbar">
            <a href="/">Home</a>
            <a href="/vehicletype">Vehicle Type</a> 
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </nav>
    </header>

    <div class="container">
        <main class="container">
            <div id="cars" class="vehicle-class-section">
            <h2 class="class-title">Cars</h2>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/1.jpg" alt="Toyota Supra mk5"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Toyota Supra mk5</h3>
                          <p class="vehicle-description">The Supra is powered by two BMW-sourced engine options: 
                            a turbocharged B48 2.0-litre inline-four or a turbocharged B58 3.0-litre inline-six. The 2.0-litre engine was 
                            initially offered in Japan, select Asian countries and Europe.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/2.jpg" alt="Benz Patent-Motorwagen"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Benz Patent-Motorwagen</h3>
                          <p class="vehicle-description">The first practical automobile ever built. Powered by a single-cylinder engine, 
                            it started the entire car industry.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/3.jpg" alt="Ford Mustang GT500"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ford Mustang GT500</h3>
                          <p class="vehicle-description">Ford Mustang Shelby GT500 A supercharged American muscle car 
                            known for its extreme horsepower, aggressive design, and track-ready performance.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/4.jpg" alt="Ford Model T"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ford Model T</h3>
                          <p class="vehicle-description">The first affordable mass-produced car. It made cars accessible to ordinary 
                            people worldwide.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/5.jpg" alt="MERCEDES BENZ G CLASS"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">MERCEDES BENZ G CLASS</h3>
                          <p class="vehicle-description">Mercedes-Benz G-Class A luxury off-road SUV famous for its iconic boxy design, 
                            powerful engine options, premium interior, and excellent off-road capability.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/6.jpg" alt="NISSAN GTR"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">NISSAN GTR</h3>
                          <p class="vehicle-description">Nissan GT-R A legendary high-performance sports car known for its 
                            twin-turbo V6 engine, advanced all-wheel-drive system, and incredible acceleration.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/7.jpg" alt="Bugatti Type 35"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Bugatti Type 35</h3>
                          <p class="vehicle-description">One of the most successful racing cars in history, 
                            dominating Grand Prix racing in the 1920s.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/8.jpg" alt="Chevrolet Camaro"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Chevrolet Camaro</h3>
                          <p class="vehicle-description">Chevrolet Camaro A powerful American muscle car known for its 
                            aggressive styling, strong V6 and V8 engine options, and high-performance driving experience.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/9.jpg" alt="Mazda MX-5 Miata"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Mazda MX-5 Miata</h3>
                          <p class="vehicle-description">Mazda MX-5 Miata A lightweight two-seat roadster sports car famous 
                            for its fun handling, responsive driving feel, and convertible design.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/cars/10.jpg" alt="Subaru WRX STI"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Subaru WRX STI</h3>
                          <p class="vehicle-description">The Subaru WRX STI is a high-performance version of the WRX, 
                            built with rally racing DNA and known for its aggressive styling, turbocharged power, 
                            and all-wheel-drive grip.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="motorcycles" class="vehicle-class-section">
            <h2 class="class-title">Motorcycles</h2>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/1.jpg" alt="Yamaha YZF R1"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Yamaha YZF R1</h3>
                          <p class="vehicle-description">Known for its crossplane engine sound and sharp handling, 
                            the R1 is one of the most iconic Japanese superbikes.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/2.jpg" alt="Kawasaki Ninja H2"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Kawasaki Ninja H2</h3>
                          <p class="vehicle-description">A futuristic motorcycle powered by a supercharged engine, 
                            delivering extreme acceleration and hyperbike performance.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/3.jpg" alt="Suzuki Hayabusa"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Suzuki Hayabusa</h3>
                          <p class="vehicle-description">Famous for being one of the fastest production motorcycles ever made, 
                            while still offering comfort for long rides.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/4.jpg" alt="Ducati Panigale V4"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ducati Panigale V4</h3>
                          <p class="vehicle-description">An exotic Italian superbike combining stunning design, 
                            MotoGP-inspired technology, and powerful V4 performance.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/5.jpg" alt="BMW S1000RR"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">BMW S1000RR</h3>
                          <p class="vehicle-description">A high-tech superbike known for speed, rider aids, 
                            and excellent balance between road and track use.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/6.jpg" alt="KTM Duke 390"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">KTM Duke 390</h3>
                          <p class="vehicle-description">A lightweight naked bike popular among beginners 
                            because of its aggressive styling and fun handling.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/7.jpg" alt="Harley Davidson Sportster S"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Harley Davidson Sportster S</h3>
                          <p class="vehicle-description">A powerful cruiser combining classic Harley styling 
                            with modern engine technology and muscular design.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/8.jpg" alt="Vispa Primavera"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Vispa Primavera</h3>
                          <p class="vehicle-description">A stylish and practical scooter known for its retro 
                            Italian design and smooth city riding experience.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/9.jpg" alt="Honda ADV160"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Honda ADV160</h3>
                          <p class="vehicle-description">rugged scooter with adventure-inspired styling, 
                            comfortable suspension, and practicality for daily commuting.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/motorcycle/10.jpg" alt="1958 Honda Super Cub"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">1958 Honda Super Cub</h3>
                          <p class="vehicle-description">A pioneering "step-through" utility machine; it is the highest-selling 
                            motor vehicle in history, lauded for its simplicity and practicality.</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div id="trucks" class="vehicle-class-section">
                <h2 class="class-title">Trucks</h2>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/1.jpg" alt="Ford Model TT 1917"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ford Model TT 1917</h3>
                          <p class="vehicle-description">The first mass-produced Ford truck, built for 
                            hauling cargo and heavy work during the early automotive era.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/2.jpg" alt="Chevrolet Advance Design 1947"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Chevrolet Advance Design 1947</h3>
                          <p class="vehicle-description">post-war pickup truck known for its durable design 
                            and classic American styling.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/3.jpg" alt="Ford F-100 (1953)"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ford F-100 (1953)</h3>
                          <p class="vehicle-description">A rugged and reliable pickup that helped shape 
                            the future of Ford’s truck lineup.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/4.jpg" alt="Toyota Hilux 1978"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Toyota Hilux 1978</h3>
                          <p class="vehicle-description">A legendary pickup famous for toughness, reliability, 
                            and strong off-road capability.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/5.jpg" alt="Mercedez Benz Unimog 1970s Modern Version"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Mercedez Benz Unimog 1970s Modern Version</h3>
                          <p class="vehicle-description">A highly capable off-road truck used in military, 
                            rescue, farming, and expedition work.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/6.jpg" alt="Semi-Trailer Truck"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Semi-Trailer Truck</h3>
                          <p class="vehicle-description">The most common technical name. It refers to the combination 
                            of a tractor unit and a semi-trailer that carries the freight.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/7.jpg" alt="Articulated Lorry"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Articulated Lorry</h3>
                          <p class="vehicle-description">Primarily used in the UK and Ireland, this term describes a vehicle 
                            consisting of a towing engine and a semi-trailer coupled to it.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/8.jpg" alt="Box Truck / Dry Van"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Box Truck / Dry Van</h3>
                          <p class="vehicle-description">While "box truck" can sometimes refer to smaller 
                            single-chassis vehicles, the specific trailer shown is a Dry Van, which is a 
                            fully enclosed trailer used to protect cargo from the elements.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/9.webp" alt="Freight Truck"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Freight Truck</h3>
                          <p class="vehicle-description">A general term used to describe heavy-duty vehicles designed 
                            specifically for the long-haul transport of goods and commodities.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/truck/10.webp" alt="Rig"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Rig</h3>
                          <p class="vehicle-description">Often called a "big rig," this is a popular colloquialism used in 
                            North America to describe the large size and complexity of the tractor-trailer combination.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="aircrafts" class="vehicle-class-section">
                <h2 class="class-title">Aircrafts</h2>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/1.jpg" alt="Airbus A380"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Airbus A380</h3>
                          <p class="vehicle-description">The world’s largest passenger aircraft, famous for its double-deck 
                            design, quiet cabin, and luxury travel experience.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/2.jpg" alt="Lockheed Martin F-22 Raptor"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Lockheed Martin F-22 Raptor</h3>
                          <p class="vehicle-description">An advanced stealth fighter jet designed for air dominance with 
                            extreme speed, agility, and radar evasion technology.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/3.jpg" alt="Lockheed Martin F-35 Lightning"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Lockheed Martin F-35 Lightning</h3>
                          <p class="vehicle-description">A next-generation stealth fighter capable of air combat, 
                            strike missions, and advanced electronic warfare.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/4.jpg" alt="Cessna 172 Skyhawk"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Cessna 172 Skyhawk</h3>
                          <p class="vehicle-description">One of the most popular training aircraft ever made, 
                            known for reliability and ease of flying.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/5.jpg" alt="Concorde"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Concorde</h3>
                          <p class="vehicle-description">A legendary supersonic airliner capable of flying faster than the 
                            speed of sound, cutting transatlantic travel times dramatically.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/6.jpg" alt="Boeing B-52 Stratofortress"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Boeing B-52 Stratofortress</h3>
                          <p class="vehicle-description">A powerful long-range bomber aircraft used for strategic 
                            missions and still active after decades of service.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/7.jpg" alt="SR-71 BlackBird"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">SR-71 BlackBird</h3>
                          <p class="vehicle-description">One of the fastest aircraft ever built, designed for 
                            high-altitude reconnaissance missions.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/8.jpg" alt="Bell Boeign V-22 Ospray"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Bell Boeign V-22 Ospray</h3>
                          <p class="vehicle-description">A unique aircraft that combines helicopter vertical takeoff 
                            ability with airplane-like speed and range.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/9.jpg" alt="Sirosky UH-60 Black Hawk"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Sirosky UH-60 Black Hawk</h3>
                          <p class="vehicle-description">A unique aircraft that combines helicopter vertical takeoff 
                            ability with airplane-like speed and range.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/aircraft/10.jpg" alt="Ford Tri-Motor"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ford Tri-Motor</h3>
                          <p class="vehicle-description">Known as the "Tin Goose," this was a major early airliner. 
                            It was an all-metal, corrugated aluminum monoplane famous for reliability, helping establish 
                            safe commercial air travel.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="watercrafts" class="vehicle-class-section">
                <h2 class="class-title">Watercrafts</h2>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/1.jpg" alt="Titanic 1972"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Titanic 1972</h3>
                          <p class="vehicle-description">A luxurious passenger ship famous for its tragic sinking 
                            after hitting an iceberg during its maiden voyage.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/2.jpg" alt="Bismarck 1939"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Bismarck 1939</h3>
                          <p class="vehicle-description">One of the most feared battleships of World War II 
                            because of its heavy armor and firepower.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/3.jpg" alt="USS Missouri BB-63 1944"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">USS Missouri BB-63 1944</h3>
                          <p class="vehicle-description">The battleship where Japan officially surrendered, 
                            marking the end of World War II.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/4.jpg" alt="USS Enterprise CVN-65 1961"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">USS Enterprise CVN-65 1961</h3>
                          <p class="vehicle-description">The world’s first nuclear-powered aircraft carrier with 
                            decades of military service.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/5.jpg" alt="Typhoon Class Submarine 1981"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Typhoon Class Submarine 1981</h3>
                          <p class="vehicle-description">One of the largest submarines ever created, built 
                            during the Cold War for nuclear deterrence.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/6.jpg" alt="Yamaha WaveRunner 1986"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Yamaha WaveRunner 1986</h3>
                          <p class="vehicle-description">A recreational jet ski designed for speed, fun, 
                            and water sports activities.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/7.jpg" alt="Sunseeker Predator 108 2000s"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Sunseeker Predator 108 2000s</h3>
                          <p class="vehicle-description">A luxury yacht combining modern performance, comfort, 
                            and premium living spaces.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/8.jpg" alt="Seawind 1160 2010s"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Seawind 1160 2010s</h3>
                          <p class="vehicle-description">A modern sailing catamaran known for stability 
                            and long-distance ocean cruising.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/9.jpg" alt="Ever Given 2018"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Ever Given 2018</h3>
                          <p class="vehicle-description">A giant cargo ship that became famous worldwide 
                            after blocking the Suez Canal.</p>
                        </div>
                    </div>
                </div>
                <div class="gallery-grid">
                    <div class="vehicle-card">
                        <div class="card-image"><img src="/pics/watercraft/10.jpg" alt="Royal Carribean Icon of the seas 2024"></div>
                        <div class="card-content">
                          <h3 class="vehicle-name">Royal Carribean Icon of the seas 2024</h3>
                          <p class="vehicle-description">One of the largest and most advanced cruise ships ever built, 
                            featuring luxury entertainment and massive amenities.</p>
                        </div>
                    </div>
                </div>
            </div>

            <p>
                Visit the <a href="/start">Start</a> page to learn how it integrates
                with OpenTDB.
            </p>
        </main>
    </div>

