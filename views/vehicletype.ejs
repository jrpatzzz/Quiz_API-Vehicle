<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="homepage-bg">

    <header class="site-header">
        <div class="logo-container">
            <img src="/pics/123.avif" alt="Logo" class="shop-logo">
        </div>

        <nav class="navbar">
            <a href="/">Home</a>
            <a href="/vehicletype">Vehicle Type</a> 
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </nav>
    </header>

    <div class="container">
      <main class="container">
          <div id="cars" class="vehicle-class-section">
              <h2 class="class-title">Cars</h2>
              <div class="gallery-grid">
                  <div class="vehicle-card">
                      <div class="card-image"><img src="/pics/car1.jpg" alt="Sedan"></div>
                      <div class="card-content">
                          <h3 class="vehicle-name">Modern Sedan</h3>
                          <p class="vehicle-description">Designed for comfort and fuel efficiency, perfect for city driving and families.</p>
                      </div>
                  </div>
                  </div>
          </div>

          <div id="motorcycles" class="vehicle-class-section">
              <h2 class="class-title">Motorcycles</h2>
              <div class="gallery-grid">
                  <div class="vehicle-card">
                      <div class="card-image"><img src="/pics/bike1.jpg" alt="Sport Bike"></div>
                      <div class="card-content">
                          <h3 class="vehicle-name">Sport Bike</h3>
                          <p class="vehicle-description">Built for speed and agility with aerodynamic frames and high-performance engines.</p>
                      </div>
                  </div>
              </div>
          </div>

          <div id="trucks" class="vehicle-class-section">
              <h2 class="class-title">Trucks</h2>
              <div class="gallery-grid">
                  <div class="vehicle-card">
                      <div class="card-image"><img src="/pics/truck1.jpg" alt="Heavy Duty"></div>
                      <div class="card-content">
                          <h3 class="vehicle-name">Heavy Duty Truck</h3>
                          <p class="vehicle-description">Engineered for hauling large loads and navigating tough, off-road terrain.</p>
                      </div>
                  </div>
              </div>
          </div>

          <div id="aircrafts" class="vehicle-class-section">
              <h2 class="class-title">Aircrafts</h2>
              <div class="gallery-grid">
                  <div class="vehicle-card">
                      <div class="card-image"><img src="/pics/plane1.jpg" alt="Jet"></div>
                      <div class="card-content">
                          <h3 class="vehicle-name">Commercial Jet</h3>
                          <p class="vehicle-description">Large aircraft designed for long-distance travel across continents and oceans.</p>
                      </div>
                  </div>
              </div>
          </div>

          <div id="watercrafts" class="vehicle-class-section">
              <h2 class="class-title">Watercrafts</h2>
              <div class="gallery-grid">
                  <div class="vehicle-card">
                      <div class="card-image"><img src="/pics/boat1.jpg" alt="Speedboat"></div>
                      <div class="card-content">
                          <h3 class="vehicle-name">Luxury Speedboat</h3>
                          <p class="vehicle-description">Fast, agile watercraft used for recreation and high-speed water transport.</p>
                      </div>
                  </div>
              </div>
          </div>

          <p>
            Visit the <a href="/start">Start</a> page to learn how it integrates
            with OpenTDB.
          </p>
      </main>
    </div>

    <footer class="site-footer">
        <p>&copy; 2026 CJH-VEHICLE QUIZ</p>
    </footer>

  </body>
</html>
